# 公共运行环境与基础设施
FARM_ENV=dev
FARM_MYSQL_DSN='farm:farm@tcp(127.0.0.1:3306)/farm?parseTime=true&loc=Local'
# 默认由会话与业务缓存共用 FARM_REDIS_ADDR。写 journal 与 Presence
# 可拆到独立 Redis 进程，避免单线程命令队列互相堵塞。
FARM_REDIS_ADDR=127.0.0.1:6379
FARM_EVENT_REDIS_ADDR=127.0.0.1:6380
FARM_PRESENCE_REDIS_ADDR=127.0.0.1:6381
FARM_INTERNAL_TOKEN=dev-only-internal-token-change-me

# 三个部署单元使用独立业务端口与运维端口，不再共享 FARM_HTTP_ADDR/FARM_ADMIN_ADDR。
FARM_GATEWAY_HTTP_ADDR=:9002
FARM_GATEWAY_ADMIN_ADDR=127.0.0.1:9302
# API 文档只在 FARM_ENV=dev 且该开关为 1 时挂载到 /docs/ 。
FARM_ENABLE_API_DOCS=1
FARM_SOCIAL_HTTP_ADDR=:9004
FARM_SOCIAL_ADMIN_ADDR=127.0.0.1:9304
FARM_FARM_HTTP_ADDR=:9100
FARM_FARM_ADMIN_ADDR=127.0.0.1:9310

# 服务发现。浏览器只访问 Gateway；其余地址均为内部 gRPC 目标（host:port）。
FARM_SOCIAL_GRPC_TARGET=127.0.0.1:9204
FARM_FARM_GRPC_TARGETS='{"farm-0":"127.0.0.1:9210"}'
FARM_GATEWAY_GRPC_TARGETS='{"gateway-0":"127.0.0.1:9202"}'
FARM_GATEWAY_GRPC_ADDR=:9202
FARM_FARM_GRPC_ADDR=:9210
FARM_SOCIAL_GRPC_ADDR=:9204

# 实例与 UID 分片路由。默认本地表把 1024 个逻辑分片全部交给 farm-0。
FARM_GATEWAY_INSTANCE_ID=gateway-0
# Kubernetes等动态Pod环境可不配置固定Gateway目标，而是发布当前gRPC端点租约。
# FARM_GATEWAY_ADVERTISE_GRPC=10.42.0.7:9202
# 或分别使用FARM_GATEWAY_ADVERTISE_HOST与FARM_GATEWAY_ADVERTISE_PORT。
# FARM_GATEWAY_INSTANCE_TTL=30s
FARM_FARM_INSTANCE_ID=farm-0
FARM_ROUTE_TABLE=deploy/route-table.local.json

# 好友邀请签名与农场风险事件盐。非 dev 环境必须使用至少 32 字节随机值。
FARM_INVITE_SECRET=dev-only-invite-change-me
FARM_HAZARD_SECRET=dev-only-hazard-secret

# 时间档：demo（1h=6s）| fast（1h=1min）| authentic（1h=1h）。
FARM_TIME_PROFILE=demo
FARM_ACTOR_IDLE_TTL=2m
FARM_ACTOR_MAX_RESIDENT=20000
FARM_COMMITTER_SHARDS=16
# Actor写操作先追加Redis Streams，再由后台Projector批量物化到MySQL。
FARM_WRITE_JOURNAL_SHARDS=32
FARM_WRITE_JOURNAL_PROJECTORS=32
FARM_WRITE_JOURNAL_BATCH=1024
FARM_WRITE_JOURNAL_BLOCK=50ms
FARM_WRITE_JOURNAL_LATEST_TTL=24h
FARM_WRITE_JOURNAL_CLAIM_IDLE=5s
# 大批写日志回放可能超过普通健康检查窗口，启动期间允许完整恢复。
FARM_WRITE_JOURNAL_RECOVERY_TIMEOUT=5m
# 单机开发为0；生产主从可设置需要WAIT确认的副本数。
FARM_WRITE_JOURNAL_REPLICAS=0
FARM_WRITE_MAX_IN_FLIGHT=512
# Farm 每250ms汇总共享 Redis 中写日志 Stream 的 pending+lag，并在64~512之间动态调整写入准入。
FARM_WRITE_DYNAMIC_ADMISSION=1
FARM_WRITE_MIN_IN_FLIGHT=64
FARM_WRITE_BACKLOG_LOW=8192
FARM_WRITE_BACKLOG_HIGH=65536
FARM_WRITE_BACKLOG_HARD=262144
FARM_WRITE_RECOVERY_STEP=64
FARM_WRITE_BACKLOG_POLL=250ms
FARM_WRITE_BACKLOG_TIMEOUT=150ms
FARM_WRITE_BACKLOG_ERROR_GRACE=2s
FARM_WRITE_ADMISSION_WAIT=5ms
# 仅供本地测试的时间推进与热切换入口，生产环境必须设为 0。
FARM_ALLOW_DEBUG_TIME=1
