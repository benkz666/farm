FARM_HTTP_ADDR=:9002
FARM_MYSQL_DSN='farm:farm@tcp(127.0.0.1:3306)/farm?parseTime=true&loc=Local'
FARM_REDIS_ADDR=127.0.0.1:6379
FARM_TOKEN_SECRET=dev-only-change-me
# 好友分享链接 HMAC 密钥；未设置时回落到 FARM_TOKEN_SECRET。生产前必须轮换。
FARM_INVITE_SECRET=dev-only-invite-change-me
# 本地/smoke 调时；生产环境务必保持未设置或 0
FARM_ALLOW_DEBUG_TIME=1

# 期 4 多实例拓扑（规格 2026-07-27-phase4-social-loop.md §3）
# FARM_ROLE：all（单进程开发默认）| gateway | farm
FARM_ROLE=all
# 当前实例 ID，需与 route-table 中某个 farm_id 一致
FARM_INSTANCE_ID=farm-0
# 路由表路径，1024 逻辑片 → farm 实例
FARM_ROUTE_TABLE=deploy/route-table.example.json
# 逻辑分片总数，协议钉死 1024；改动会让历史 uid 路由错位
FARM_LOGICAL_SHARDS=1024

# 期 4 跨农场事件总线。生产/多 Farm 默认 Kafka；单测和单进程可显式设为 memory。
FARM_BUS=kafka
# 宿主机运行 farm-server 时连接 compose 暴露的 Kafka；容器内服务使用 kafka:9092。
FARM_KAFKA_BROKERS=127.0.0.1:9094
