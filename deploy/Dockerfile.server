# 期 4 双分片本地联调：构建单一 farm-server 二进制，由 compose 按角色启动。
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/farm-server ./cmd/farm-server

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/farm-server /app/farm-server
COPY deploy/route-table.example.json /app/deploy/route-table.example.json
EXPOSE 9100 9101 9200 9201
ENTRYPOINT ["/app/farm-server"]
