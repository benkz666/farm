# 三个服务共用构建模板，但每次只产出 ARG PACKAGE 指定的独立二进制。
FROM golang:1.25-bookworm AS build
ARG PACKAGE
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN test -n "$PACKAGE" \
  && CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/service "${PACKAGE}"

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/service /app/service
COPY deploy/route-table.local.json /app/deploy/route-table.local.json
EXPOSE 9002 9004 9100
ENTRYPOINT ["/app/service"]
